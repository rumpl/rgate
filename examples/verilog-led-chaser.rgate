      {
        "name": "led_chaser",
        "verilog": "// RGate LED chaser example. GPL-3.0-or-later.\n`timescale 1ns/1ps\nmodule led_chaser (\n    input wire clk,\n    input wire reset,\n    input wire enable,\n    input wire reverse,\n    input wire [3:0] speed,\n    output reg [7:0] leds\n);\n    reg [3:0] divider;\n\n    always @(posedge clk) begin\n        if (reset) begin\n            leds <= 8'b00000001;\n            divider <= 0;\n        end else if (enable) begin\n            if (divider >= speed) begin\n                divider <= 0;\n                if (reverse)\n                    leds <= {leds[0], leds[7:1]};\n                else\n                    leds <= {leds[6:0], leds[7]};\n            end else begin\n                divider <= divider + 1;\n            end\n        end\n    end\nendmodule\n",
        "gates": [],
        "nets": [
          {
            "id": 1,
            "name": "clk",
            "width": 1,
            "show_name": true,
            "port": "input"
          },
          {
            "id": 2,
            "name": "reset",
            "width": 1,
            "show_name": true,
            "port": "input"
          },
          {
            "id": 3,
            "name": "enable",
            "width": 1,
            "show_name": true,
            "port": "input"
          },
          {
            "id": 4,
            "name": "reverse",
            "width": 1,
