,"width":16,"show_name":true,"port":"output"},{"id":15,"name":"R3","width":16,"show_name":true,"port":"output"},{"id":16,"name":"R4","width":16,"show_name":true,"port":"output"},{"id":17,"name":"R5","width":16,"show_name":true,"port":"output"},{"id":18,"name":"R6","width":16,"show_name":true,"port":"output"},{"id":19,"name":"R7","width":16,"show_name":true,"port":"output"},{"id":20,"name":"OPCODE","width":4,"show_name":true,"port":null},{"id":21,"name":"HALT_TRAP","width":1,"show_name":true,"port":null},{"id":22,"name":"CONTROL","width":32,"show_name":true,"port":null},{"id":23,"name":"A","width":16,"show_name":true,"port":null},{"id":24,"name":"B","width":16,"show_name":true,"port":null},{"id":25,"name":"DR","width":3,"show_name":true,"port":null},{"id":26,"name":"SR1","width":3,"show_name":true,"port":null},{"id":27,"name":"SR2","width":3,"show_name":true,"port":null},{"id":28,"name":"WRITE_REG","width":1,"show_name":true,"port":null},{"id":29,"name":"BUS","width":16,"show_name":true,"port":null}],"wires":[{"id":1,"net":20,"points":[{"x":605.0,"y":334.0},{"x":622.0,"y":334.0},{"x":622.0,"y":382.0},{"x":158.0,"y":382.0},{"x":158.0,"y":286.0},{"x":175.0,"y":286.0}],"start":{"gate":2,"pin":"OPCODE"},"end":{"gate":1,"pin":"OPCODE"}},{"id":2,"net":21,"points":[{"x":605.0,"y":346.0},{"x":622.0,"y":346.0},{"x":622.0,"y":382.0},{"x":498.0,"y":382.0},{"x":498.0,"y":316.0},{"x":158.0,"y":316.0},{"x":158.0,"y":298.0},{"x":175.0,"y":298.0}],"start":{"gate":2,"pin":"HALT_TRAP"},"end":{"gate":1,"pin":"HALT_TRAP"}},{"id":3,"net":22,"points":[{"x":265.0,"y":286.0},{"x":282.0,"y":286.0},{"x":282.0,"y":274.0},{"x":515.0,"y":274.0}],"start":{"gate":1,"pin":"CONTROL"},"end":{"gate":2,"pin":"CONTROL"}},{"id":4,"net":23,"points":[{"x":945.0,"y":226.0},{"x":962.0,"y":226.0},{"x":962.0,"y":178.0},{"x":498.0,"y":178.0},{"x":498.0,"y":298.0},{"x":515.0,"y":298.0}],"start":{"gate":3,"pin":"A"},"end":{"gate":2,"pin":"A"}},{"id":5,"net":24,"points":[{"x":945.0,"y":238.0},{"x":962.0,"y":238.0},{"x":962.0,"y":202.0},{"x":622.0,"y":202.0},{"x":622.0,"y":178.0},{"x":498.0,"y":178.0},{"x":498.0,"y":310.0},{"x":515.0,"y":310.0}],"start":{"gate":3,"pin":"B"},"end":{"gate":2,"pin":"B"}},{"id":6,"net":25,"points":[{"x":605.0,"y":202.0},{"x":622.0,"y":202.0},{"x":622.0,"y":280.0},{"x":855.0,"y":280.0}],"start":{"gate":2,"pin":"DR"},"end":{"gate":3,"pin":"DR"}},{"id":7,"net":26,"points":[{"x":605.0,"y":214.0},{"x":838.0,"y":214.0},{"x":838.0,"y":292.0},{"x":855.0,"y":292.0}],"start":{"gate":2,"pin":"SR1"},"end":{"gate":3,"pin":"SR1"}},{"id":8,"net":27,"points":[{"x":605.0,"y":226.0},{"x":622.0,"y":226.0},{"x":622.0,"y":304.0},{"x":855.0,"y":304.0}],"start":{"gate":2,"pin":"SR2"},"end":{"gate":3,"pin":"SR2"}},{"id":9,"net":28,"points":[{"x":605.0,"y":238.0},{"x":838.0,"y":238.0},{"x":838.0,"y":268.0},{"x":855.0,"y":268.0}],"start":{"gate":2,"pin":"WRITE_REG"},"end":{"gate":3,"pin":"WRITE"}},{"id":10,"net":29,"points":[{"x":605.0,"y":250.0},{"x":838.0,"y":250.0},{"x":838.0,"y":316.0},{"x":855.0,"y":316.0}],"start":{"gate":2,"pin":"BUS"},"end":{"gate":3,"pin":"DATA"}}]},{"name":"LC3RegisterFileHDL","gates":[],"nets":[{"id":1,"name":"CLK","width":1,"show_name":true,"port":"input"},{"id":2,"name":"RESET_N","width":1,"show_name":true,"port":"input"},{"id":3,"name":"WRITE","width":1,"show_name":true,"port":"input"},{"id":4,"name":"DR","width":3,"show_name":true,"port":"input"},{"id":5,"name":"SR1","width":3,"show_name":true,"port":"input"},{"id":6,"name":"SR2","width":3,"show_name":true,"port":"input"},{"id":7,"name":"DATA","width":16,"show_name":true,"port":"input"},{"id":8,"name":"A","width":16,"show_name":true,"port":"output"},{"id":9,"name":"B","width":16,"show_name":true,"port":"output"},{"id":10,"name":"R0","width":16,"show_name":true,"port":"output"},{"id":11,"name":"R1","width":16,"show_name":true,"port":"output"},{"id":12,"name":"R2","width":16,"show_name":true,"port":"output"},{"id":13,"name":"R3","width":16,"show_name":true,"port":"output"},{"id":14,"name":"R4","width":16,"show_name":true,"port":"output"},{"id":15,"name":"R5","width":16,"show_name":true,"port":"output"},{"id":16,"name":"R6","width":16,"show_name":true,"port":"output"},{"id":17,"name":"R7","width":16,"show_name":true,"port":"output"}],"wires":[],"verilog":"`timescale 1ns/1ps\nmodule LC3RegisterFileHDL (\n    input wire CLK,\n    input wire RESET_N,\n    input wire WRITE,\n    input wire [2:0] DR,\n    input wire [2:0] SR1,\n    input wire [2:0] SR2,\n    input wire [15:0] DATA,\n    output wire [15:0] A,\n    output wire [15:0] B,\n    output wire [15:0] R0,\n    output wire [15:0] R1,\n    output wire [15:0] R2,\n    output wire [15:0] R3,\n    output wire [15:0] R4,\n    output wire [15:0] R5,\n    output wire [15:0] R6,\n    output wire [15:0] R7\n);\n    reg [15:0] registers [0:7];\n    integer i;\n    always @(posedge CLK or negedge RESET_N) begin\n        if (!RESET_N) begin\n            for (i = 0; i < 8; i = i + 1)\n                registers[i] <= 16'b0;\n        end else if (WRITE) begin\n            registers[DR] <= DATA;\n        end\n    end\n    assign A = registers[SR1];\n    assign B = registers[SR2];\n    assign R0 = registers[0];\n    assign R1 = registers[1];\n    assign R2 = registers[2];\n    assign R3 = registers[3];\n    assign R4 = registers[4];\n    assign R5 = registers[5];\n    assign R6 = registers[6];\n    assign R7 = registers[7];\nendmodule\n"},{"name":"LC3ControlHDL","gates":[],"nets":[{"id":1,"name":"CLK","width":1,"show_name":true,"port":"input"},{"id":2,"name":"RESET_N","width":1,"show_name":true,"port":"input"},{"id":3,"name":"OPCODE","width":4,"show_name":true,"port":"input"},{"id":4,"name":"HALT_TRAP","width":1,"show_name":true,"port":"input"},{"id":5,"name":"STATE","width":8,"show_name":true,"port":"output"},{"id":6,"name":"CONTROL","width":32,"show_name":true,"port":"output"}],"wires":[],"verilog":"`timescale 1ns/1ps\nmodule LC3ControlHDL (\n    input wire CLK,\n    input wire RESET_N,\n    input wire [3:0] OPCODE,\n    input wire HALT_TRAP,\n    output reg [7:0] STATE,\n    output reg [31:0] CONTROL\n);\n    // Same control-word layout and microstates as the schematic LC-3 ROM.\n    wire [7:0] dispatch = 8'd16 + {OPCODE, 3'b000};\n    always @(posedge CLK or negedge RESET_N) begin\n        if (!RESET_N) STATE <= 0;\n        else if (CONTROL[29] && HALT_TRAP) STATE <= 8'hff;\n        else if (CONTROL[28]) STATE <= dispatch;\n        else STATE <= CONTROL[7:0];\n    end\n    always @* begin\n        case (STATE)\n            8'd0: CONTROL = 32'h00000e01;\n            8'd1: CONTROL = 32'h00002102;\n            8'd2: CONTROL = 32'h00001303;\n            8'd3: CONTROL = 32'h00000a04;\n            8'd4: CONTROL = 32'h10000001;\n            8'd16: CONTROL = 32'h01000c01;\n            8'd24: CONTROL = 32'h00018001;\n            8'd32: CONTROL = 32'h00002421;\n            8'd33: CONTROL = 32'h00018301;\n            8'd40: CONTROL = 32'h00002429;\n            8'd41: CONTROL = 32'h4000452a;\n            8'd42: CONTROL = 32'h00020001;\n            8'd48: CONTROL = 32'h00808131;\n            8'd49: CONTROL = 32'h08200c01;\n            8'd56: CONTROL = 32'h00058001;\n            8'd64: CONTROL = 32'h00502441;\n            8'd65: CONTROL = 32'h00018301;\n            8'd72: CONTROL = 32'h00502449;\n            8'd73: CONTROL = 32'h4000454a;\n            8'd74: CONTROL = 32'h00020001;\n            8'd88: CONTROL = 32'h00098001;\n            8'd96: CONTROL = 32'h00002461;\n            8'd97: CONTROL = 32'h00002362;\n            8'd98: CONTROL = 32'h00018301;\n            8'd104: CONTROL = 32'h00002469;\n            8'd105: CONTROL = 32'h0000236a;\n            8'd106: CONTROL = 32'h4000456b;\n            8'd107: CONTROL = 32'h00020001;\n            8'd112: CONTROL = 32'h00000d01;\n            8'd128: CONTROL = 32'h00018401;\n            8'd136: CONTROL = 32'h00808189;\n            8'd137: CONTROL = 32'h2000278a;\n            8'd138: CONTROL = 32'h00000b01;\n            default: CONTROL = 32'h020000ff;\n        endcase\n    end\nendmodule\n"},{"name":"LC3DatapathHDL","gates":[],"nets":[{"id":1,"name":"CLK","width":1,"show_name":true,"port":"input"},{"id":2,"name":"RESET_N","width":1,"show_name":true,"port":"input"},{"id":3,"name":"CONTROL","width":32,"show_name":true,"port":"input"},{"id":4,"name":"MEM_READ","width":16,"show_name":true,"port":"input"},{"id":5,"name":"A","width":16,"show_name":true,"port":"input"},{"id":6,"name":"B","width":16,"show_name":true,"port":"input"},{"id":7,"name":"DR","width":3,"show_name":true,"port":"output"},{"id":8,"name":"SR1","width":3,"show_name":true,"port":"output"},{"id":9,"name":"SR2","width":3,"show_name":true,"port":"output"},{"id":10,"name":"WRITE_REG","width":1,"show_name":true,"port":"output"},{"id":11,"name":"BUS","width":16,"show_name":true,"port":"output"},{"id":12,"name":"PC","width":16,"show_name":true,"port":"output"},{"id":13,"name":"IR","width":16,"show_name":true,"port":"output"},{"id":14,"name":"MEM_ADDR","width":16,"show_name":true,"port":"output"},{"id":15,"name":"MEM_WRITE","width":16,"show_name":true,"port":"output"},{"id":16,"name":"WRITE_MEM","width":1,"show_name":true,"port":"output"},{"id":17,"name":"CC","width":3,"show_name":true,"port":"output"},{"id":18,"name":"OPCODE","width":4,"show_name":true,"port":"output"},{"id":19,"name":"HALT_TRAP","width":1,"show_name":true,"port":"output"},{"id":20,"name":"HALTED","width":1,"show_name":true,"port":"output"}],"wires":[],"verilog":"`timescale 1ns/1ps\nmodule LC3DatapathHDL (\n    input wire CLK,\n    input wire RESET_N,\n    input wire [31:0] CONTROL,\n    input wire [15:0] MEM_READ,\n    input wire [15:0] A,\n    input wire [15:0] B,\n    output wire [2:0] DR,\n    output wire [2:0] SR1,\n    output wire [2:0] SR2,\n    output wire WRITE_REG,\n    output reg [15:0] BUS,\n    output reg [15:0] PC,\n    output reg [15:0] IR,\n    output reg [15:0] MEM_ADDR,\n    output reg [15:0] MEM_WRITE,\n    output wire WRITE_MEM,\n    output reg [2:0] CC,\n    output wire [3:0] OPCODE,\n    output wire HALT_TRAP,\n    output wire HALTED\n);\n    wire [15:0] signed5 = {{11{IR[4]}}, IR[4:0]};\n    wire [15:0] signed6 = {{10{IR[5]}}, IR[5:0]};\n    wire [15:0] signed9 = {{7{IR[8]}}, IR[8:0]};\n    wire [15:0] signed11 = {{5{IR[10]}}, IR[10:0]};\n    wire [15:0] operand_b = IR[5] ? signed5 : B;\n    reg [15:0] alu_result;\n    reg [15:0] offset;\n    wire [15:0] address_base = CONTROL[22] ? A : PC;\n    wire [15:0] effective_address = address_base + offset;\n    wire [15:0] address_or_jump = CONTROL[27] && !IR[11] ? A : effective_address;\n    wire branch_taken = |(CC & IR[11:9]);\n\n    assign DR = CONTROL[23] ? 3'd7 : IR[11:9];\n    assign SR1 = CONTROL[30] ? IR[11:9] : IR[8:6];\n    assign SR2 = IR[2:0];\n    assign WRITE_REG = CONTROL[15];\n    assign WRITE_MEM = CONTROL[17] && RESET_N;\n    assign OPCODE = IR[15:12];\n    assign HALT_TRAP = IR[7:0] == 8'h25;\n    assign HALTED = CONTROL[25];\n\n    always @* begin\n        case (CONTROL[19:18])\n            2'd0: alu_result = A + operand_b;\n            2'd1: alu_result = A & operand_b;\n            2'd2: alu_result = ~A;\n            default: alu_result = A;\n        endcase\n        case (CONTROL[21:20])\n            2'd0: offset = signed9;\n            2'd1: offset = signed6;\n            2'd2: offset = signed11;\n            default: offset = B;\n        endcase\n        case (CONTROL[10:8])\n            3'd0: BUS = alu_result;\n            3'd1: BUS = PC;\n            3'd2: BUS = PC + 16'd1;\n            3'd3: BUS = MEM_READ;\n            3'd4: BUS = address_or_jump;\n            3'd5: BUS = A;\n            3'd6: BUS = 16'h3000;\n            default: BUS = {8'b0, IR[7:0]};\n        endcase\n    end\n\n    always @(posedge CLK or negedge RESET_N) begin\n        if (!RESET_N) begin\n            PC <= 0;\n            IR <= 0;\n            MEM_ADDR <= 0;\n            MEM_WRITE <= 0;\n            CC <= 0;\n        end else begin\n            if (CONTROL[11] && (!CONTROL[24] || branch_taken)) PC <= BUS;\n            if (CONTROL[12]) IR <= BUS;\n            if (CONTROL[13]) MEM_ADDR <= BUS;\n            if (CONTROL[14]) MEM_WRITE <= BUS;\n            if (CONTROL[16]) CC <= {BUS[15], BUS == 0, !BUS[15] && BUS != 0};\n        end\n    end\nendmodule\n"},{"name":"LC3MemoryHDL","gates":[],"nets":[{"id":1,"name":"CLK","width":1,"show_name":true,"port":"input"},{"id":2,"name":"RESET_N","width":1,"show_name":true,"port":"input"},{"id":3,"name":"ADDRESS","width":16,"show_name":true,"port":"input"},{"id":4,"name":"WRITE_DATA","width":16,"show_name":true,"port":"input"},{"id":5,"name":"WRITE","width":1,"show_name":true,"port":"input"},{"id":6,"name":"READ_DATA","width":16,"show_name":true,"port":"output"},{"id":7,"name":"RESULT","width":16,"show_name":true,"port":"output"},{"id":8,"name":"CONSOLE","width":24,"show_name":true,"port":"output"},{"id":9,"name":"TX","width":8,"show_name":true,"port":"output"},{"id":10,"name":"TX_COUNT","width":16,"show_name":true,"port":"output"}],"wires":[],"verilog":"`timescale 1ns/1ps\nmodule LC3MemoryHDL (\n    input wire CLK,\n    input wire RESET_N,\n    input wire [15:0] ADDRESS,\n    input wire [15:0] WRITE_DATA,\n    input wire WRITE,\n    output wire [15:0] READ_DATA,\n    output wire [15:0] RESULT,\n    output reg [23:0] CONSOLE,\n    output reg [7:0] TX,\n    output reg [15:0] TX_COUNT\n);\n    reg [15:0] memory [0:65535];\n    integer i;\n    // Embedded image keeps the example independent of the simulator's directory.\n    initial begin\n        for (i = 0; i < 65536; i = i + 1) memory[i] = 0;\n        memory[16'h0021] = 16'h3100;\n        memory[16'h3000] = 16'h5020;\n        memory[16'h3001] = 16'h5260;\n        memory[16'h3002] = 16'h1265;\n        memory[16'h3003] = 16'h1001;\n        memory[16'h3004] = 16'h127F;\n        memory[16'h3005] = 16'h03FD;\n        memory[16'h3006] = 16'h3019;\n        memory[16'h3007] = 16'h2019;\n        memory[16'h3008] = 16'hF021;\n        memory[16'h3009] = 16'h2018;\n        memory[16'h300A] = 16'hF021;\n        memory[16'h300B] = 16'h2017;\n        memory[16'h300C] = 16'hF021;\n        memory[16'h300D] = 16'hF025;\n        memory[16'h3020] = 16'h0000;\n        memory[16'h3021] = 16'h0048;\n        memory[16'h3022] = 16'h0049;\n        memory[16'h3023] = 16'h000A;\n        memory[16'h3100] = 16'h2402;\n        memory[16'h3101] = 16'h7080;\n        memory[16'h3102] = 16'hC1C0;\n        memory[16'h3103] = 16'hFE06;\n    end\n    assign READ_DATA = memory[ADDRESS];\n    assign RESULT = memory[16'h3020];\n    always @(posedge CLK or negedge RESET_N) begin\n        if (!RESET_N) begin\n            CONSOLE <= 0;\n            TX <= 0;\n            TX_COUNT <= 0;\n        end else if (WRITE) begin\n            memory[ADDRESS] <= WRITE_DATA;\n            if (ADDRESS == 16'hfe06) begin\n                CONSOLE <= {CONSOLE[15:0], WRITE_DATA[7:0]};\n                TX <= WRITE_DATA[7:0];\n                TX_COUNT <= TX_COUNT + 1;\n            end\n        end\n    end\nendmodule\n"}]}}
